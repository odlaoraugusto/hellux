APP_NAME=Hellux
APP_VERSION=1.2.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://hellux:hellux@db:5432/hellux

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Em produção: gere uma chave forte, ex.: `openssl rand -hex 32`.
# A aplicação se recusa a iniciar em ENVIRONMENT=production com o valor padrão abaixo.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usado apenas pelo docker-compose.prod.yml (senha do Postgres em produção).
POSTGRES_PASSWORD=troque-esta-senha-em-producao

# Usada pela importação de laudo (extração assistida por IA - ver LaudoImportService).
ANTHROPIC_API_KEY=
