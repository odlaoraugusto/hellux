## Dockerfile de PRODUÇÃO do backend.
## Para desenvolvimento, use o Dockerfile padrão (com --reload) via docker-compose.yml.
## Este arquivo é usado pelo docker-compose.prod.yml.

FROM python:3.12-slim AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Usuário não-root - nunca rodar a aplicação como root em produção.
RUN useradd --create-home --shell /bin/bash hellux \
    && chown -R hellux:hellux /app
USER hellux

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# 1 worker de propósito: o rate limiter de login (app/core/rate_limit.py)
# guarda a contagem em memória do próprio processo - com mais de um worker,
# cada um teria sua própria contagem e o limite de "5/minuto por IP" viraria
# impreciso (até 5 * número de workers). Um worker uvicorn é assíncrono e dá
# conta do volume de um laboratório sozinho; se o tráfego crescer a ponto de
# precisar de mais workers, o limiter precisa migrar pra um storage
# compartilhado (Redis) antes de aumentar esse número.
CMD ["gunicorn", "app.main:app", \
     "--workers", "1", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
